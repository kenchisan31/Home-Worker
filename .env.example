# Chuỗi kết nối Neon (Neon Console -> Connect)
DATABASE_URL=
# Email quản trị xem được /admin.html (cách nhau bằng dấu phẩy)
ADMIN_EMAILS=

# Domain chính dùng cho canonical URL, sitemap và robots.txt
SITE_URL=https://ten-mien-cua-ban.vn

# Web Push: tạo bằng npm run push:keys, chỉ lưu PRIVATE KEY ở Vercel server env
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@your-domain.vn
# Tỷ lệ phí nền tảng mặc định (5%)
PLATFORM_FEE_RATE=0.05
